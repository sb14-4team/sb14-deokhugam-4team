POSTGRES_PORT=5432
POSTGRES_DB=deokhugam
POSTGRES_USER=deokhugam
POSTGRES_PASSWORD=deokhugam-local
# 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key
# https://ocr.space/ocrapi/freekey 에서 무료 키 발급 (하루 500회, 월 25,000회, 1MB)
OCR_SPACE_API_KEY=your-ocr-space-api-key
# S3 썸네일 저장. 액세스 키는 넣지 않는다. 앱 실행 전에 AWS CLI 2.32 이상으로 `aws login` (12시간마다)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-bucket

# 모니터링 실험용 (docker compose --profile monitoring)
ELASTIC_PASSWORD=elastic-local
KIBANA_SYSTEM_PASSWORD=kibana-local
FILEBEAT_ES_PASSWORD=filebeat-local
GRAFANA_ES_PASSWORD=grafana-reader-local
GRAFANA_ADMIN_PASSWORD=grafana-local
GRAFANA_PORT=3001
