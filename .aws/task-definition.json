{
  "family": "deokhugam",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/deokhugam-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "deokhugam-app",
      "image": "IMAGE_IS_SET_BY_WORKFLOW",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "TZ", "value": "Asia/Seoul" },
        { "name": "OTLP_METRICS_ENABLED", "value": "true" }
      ],
      "secrets": [
        { "name": "DB_URL", "valueFrom": "arn:aws:ssm:ap-southeast-2:<AWS_ACCOUNT_ID>:parameter/deokhugam/prod/DB_URL" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:ssm:ap-southeast-2:<AWS_ACCOUNT_ID>:parameter/deokhugam/prod/DB_USERNAME" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:ap-southeast-2:<AWS_ACCOUNT_ID>:parameter/deokhugam/prod/DB_PASSWORD" },
        { "name": "OTLP_METRICS_URL", "valueFrom": "arn:aws:ssm:ap-southeast-2:<AWS_ACCOUNT_ID>:parameter/deokhugam/prod/OTLP_METRICS_URL" },
        { "name": "OTLP_AUTH_HEADER", "valueFrom": "arn:aws:ssm:ap-southeast-2:<AWS_ACCOUNT_ID>:parameter/deokhugam/prod/OTLP_AUTH_HEADER" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/deokhugam",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "app"
        }
      },
      "stopTimeout": 30
    }
  ]
}
